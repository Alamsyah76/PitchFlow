# Backend Environment Variables
# Copy this file to .env and fill in real values locally.
# Never commit real secrets.

# Runtime mode
# Set to 1 only for local SQLite smoke tests.
USE_SQLITE_DEV=0

# Supabase configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated

# PostgreSQL / Supabase database
# Use the Supabase pooled or direct Postgres connection string.
DATABASE_URL=postgresql://postgres:replace-with-password@db.your-project-ref.supabase.co:5432/postgres

# LLM providers
OPENAI_API_KEY=replace-with-openai-api-key
GEMINI_API_KEY=replace-with-gemini-api-key
COHERE_API_KEY=replace-with-cohere-api-key
COHERE_RERANK_MODEL=rerank-v3.5

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Vector store
VECTOR_EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIMENSION=1536
VECTOR_SIMILARITY_TOP_K=3

# Logging
LOG_LEVEL=INFO

# Local embedding fallback
USE_OLLAMA=False
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
